@model QuanLySach.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách";
}

<div class="container">

    <h1>Chi tiết sách</h1>

    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            Mã sách
        </dt>
        <dd class="col-sm-9">
            @Model.Id
        </dd>

        <dt class="col-sm-3">
            Tên sách
        </dt>
        <dd class="col-sm-9">
            @Model.Title
        </dd>

        <dt class="col-sm-3">
            Tác giả
        </dt>
        <dd class="col-sm-9">
            @Model.Author
        </dd>

        <dt class="col-sm-3">
            Nhà xuất bản
        </dt>
        <dd class="col-sm-9">
            @Model.Publisher
        </dd>

        <dt class="col-sm-3">
            Giá sách
        </dt>
        <dd class="col-sm-9">
            @Model.Price.ToString("N0") VNĐ
        </dd>

        <dt class="col-sm-3">
            Năm xuất bản
        </dt>
        <dd class="col-sm-9">
            @Model.PublishedYear
        </dd>

    </dl>

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Sửa thông tin
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại danh sách
    </a>

</div>